{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: ChordSH (refactored)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_refactored.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "args": []
    },
    {
      "name": "Python: ChordSH (legacy main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "args": []
    },
    {
      "name": "Python: pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "args": ["tests", "-v"]
    },
    {
      "name": "Python: pytest (unit tests only)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "tests",
        "--ignore=tests/test_interval_game_integration.py",
        "--ignore=tests/test_master_engine_integration.py",
        "-v"
      ]
    },
    {
      "name": "Python: pytest (integration tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "tests/test_interval_game_integration.py",
        "tests/test_master_engine_integration.py",
        "-v"
      ]
    }
  ]
}
